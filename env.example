# These go into Vercel -> Project -> Settings -> Environment Variables.
# (Do not commit a real .env to GitHub.)

TELEGRAM_BOT_TOKEN=token_from_botfather
TELEGRAM_WEBHOOK_SECRET=make_up_a_long_random_string_A-Z_a-z_0-9

GMAIL_ADDRESS=yourname@gmail.com
GMAIL_APP_PASSWORD=16_character_google_app_password
SENDER_NAME=EkLabs

# Use a NEW key, not the one from STOCKFLOW
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_keep_secret

SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxx/exec
SHEET_SECRET=same_value_as_SECRET_in_apps_script

# Comma separated chat IDs (send /id to the bot). Empty = anyone can use it.
ALLOWED_CHAT_IDS=
# Skip mailing the same address again within N hours (0 = always mail)
DUPLICATE_HOURS=24
